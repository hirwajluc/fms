# CodeIgniter specific files
system/session/*
!system/session/.gitkeep
system/logs/*
!system/logs/.gitkeep



# Database backups (allow in db/ folder)
*.sql
!db/*.sql

# Generated report PDFs (large, regenerated on demand)
assets/reports/*.pdf

# Uploaded user files (managed outside git)
assets/uploads/*
!assets/uploads/.gitkeep
assets/signatures/*
!assets/signatures/.gitkeep
assets/otherfiles/*
!assets/otherfiles/.gitkeep

# IDE and OS files
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~


# Environment files
.env
.env.local
